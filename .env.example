# A股数据采集系统配置文件
# 复制此文件为 .env 并修改配置

# 数据库配置（请修改为实际值）
DB_HOST=192.168.2.32
DB_PORT=2881
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=astock

# 必盈API配置（可选）
# 获取免费API Key: https://www.biyingapi.com/get-free-cert.html
BIYING_API_KEY=your_biying_licence_key

# 采集配置（可选）
# COLLECTOR_THREADS=10
# COLLECTOR_BATCH_SIZE=50
