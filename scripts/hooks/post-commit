#!/usr/bin/env python3
"""
Git post-commit hook: 检测分支名 → 提示下一步操作
使用方法：复制到 .git/hooks/post-commit（无后缀）

分支命名约定：feature/{轮次}-{任务}
"""

import subprocess
import re

def get_current_branch():
    """获取当前分支名"""
    result = subprocess.run(
        ['git', 'branch', '--show-current'],
        capture_output=True, text=True
    )
    return result.stdout.strip()

def get_commit_message():
    """获取最新 commit message"""
    result = subprocess.run(
        ['git', 'log', '-1', '--pretty=format:%s'],
        capture_output=True, text=True
    )
    return result.stdout.strip()

def parse_branch_info(branch):
    """解析分支名获取轮次和任务"""
    # 格式: feature/55-t2 或 feature/55-t2-api
    match = re.match(r'feature/(\d+)-t(\d+)', branch)
    if match:
        return int(match.group(1)), int(match.group(2))
    return None, None

def main():
    branch = get_current_branch()
    msg = get_commit_message()

    print(f"[hook] 分支: {branch}")
    print(f"[hook] Commit: {msg}")

    round_num, task_num = parse_branch_info(branch)

    if round_num and task_num:
        print(f"[hook] ✅ 任务识别: Round {round_num} T-{task_num}")
        print(f"[hook] 提示: 完成后执行以下命令:")
        print(f"[hook]   git checkout main")
        print(f"[hook]   git merge {branch} --no-ff -m 'feat({round_num}): T-{task_num} 完成'")
        print(f"[hook]   git tag round-{round_num}-dev")
        print(f"[hook]   git push origin main --tags")
    elif branch == 'main' or branch == 'master':
        # 主分支提交，检查是否有 tag
        result = subprocess.run(
            ['git', 'tag', '--list', '*-dev'],
            capture_output=True, text=True
        )
        tags = result.stdout.strip().split('\n')
        if tags and tags[0]:
            print(f"[hook] ⚠️ 主分支有待审查 tag: {tags}")
            print(f"[hook] 提示: 通知测试 Agent 执行 /review")
        else:
            print("[hook] ✅ 主分支提交，无待审查任务")
    else:
        print(f"[hook] 分支 '{branch}' 不符合 feature/{轮次}-{任务} 格式")

if __name__ == '__main__':
    main()