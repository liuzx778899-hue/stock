#!/usr/bin/env python3
"""
Git post-commit hook: 解析 commit message → 更新 agent-tasks.md
使用方法：复制到 .git/hooks/post-commit（无后缀）
"""

import re
import subprocess
import os

def get_commit_message():
    """获取最新 commit message"""
    result = subprocess.run(
        ['git', 'log', '-1', '--pretty=format:%s'],
        capture_output=True, text=True
    )
    return result.stdout.strip()

def parse_task_from_message(msg):
    """解析 commit message 中的任务编号

    支持格式：
    - feat: xxx #54-T1
    - fix: xxx #53-T2
    - feat: xxx (第五十四轮 T-2)
    """
    # 格式1: #XX-TY
    match = re.search(r'#(\d+)-T(\d+)', msg)
    if match:
        return f"第五{num_to_cn(int(match.group(1)))}轮 T-{match.group(2)}"

    # 格式2: (第五XX轮 T-Y)
    match = re.search(r'第五(\S+)轮\s+T-?(\d+)', msg)
    if match:
        return f"第五{match.group(1)}轮 T-{match.group(2)}"

    return None

def num_to_cn(num):
    """数字转中文"""
    mapping = {10: '十', 20: '二十', 30: '三十', 40: '四十', 50: '五十',
               51: '五十一', 52: '五十二', 53: '五十三', 54: '五十四',
               55: '五十五', 60: '六十'}
    return mapping.get(num, str(num))

def update_agent_tasks(task_id):
    """更新 agent-tasks.md 中任务状态为【已完成】"""
    tasks_file = 'agent-tasks.md'
    if not os.path.exists(tasks_file):
        print(f"[hook] {tasks_file} 不存在，跳过")
        return

    with open(tasks_file, 'r', encoding='utf-8') as f:
        content = f.read()

    # 查找并更新任务状态
    # 匹配: - [ ] T-X: 或 - [x] T-X:
    pattern = rf'(- \[ \] T-?{task_id.split("-")[-1]}:)'
    if re.search(pattern, content):
        content = re.sub(pattern, lambda m: m.group(0).replace('[ ]', '[x]'), content)
        with open(tasks_file, 'w', encoding='utf-8') as f:
            f.write(content)
        print(f"[hook] ✅ 已更新任务状态: {task_id}")
    else:
        print(f"[hook] ⚠️ 未找到任务: {task_id}")

def main():
    msg = get_commit_message()
    print(f"[hook] Commit: {msg}")

    task = parse_task_from_message(msg)
    if task:
        print(f"[hook] 识别任务: {task}")
        update_agent_tasks(task)
    else:
        print("[hook] 未识别任务编号，跳过更新")

if __name__ == '__main__':
    main()
