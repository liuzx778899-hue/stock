#!/usr/bin/env python3
"""
Git commit-msg hook: 验证 commit message 格式
使用方法：复制到 .git/hooks/commit-msg（无后缀）

Commit message 格式规范：
- feat: xxx #54-T1        (新功能 + 任务编号)
- fix: xxx #53-T2         (Bug修复 + 任务编号)
- feat: xxx (第五十四轮 T-2)  (中文格式)
- docs: xxx               (文档更新，可无任务编号)
"""

import re
import sys

def validate_commit_message(msg):
    """验证 commit message 格式"""

    # 允许的类型
    valid_types = ['feat', 'fix', 'docs', 'style', 'refactor', 'test', 'chore', 'perf', 'ci', 'build', 'revert']

    # 提取第一行（标题）
    first_line = msg.split('\n')[0].strip()

    # 格式: type: description
    match = re.match(r'^(\w+):\s*(.+)$', first_line)
    if not match:
        print(f"[hook] ❌ 格式错误: '{first_line}'")
        print("[hook] 正确格式: feat: xxx #54-T1 或 fix: xxx (第五十四轮 T-2)")
        return False

    commit_type, description = match.groups()

    # 检查类型
    if commit_type not in valid_types:
        print(f"[hook] ⚠️ 类型 '{commit_type}' 不在推荐列表: {valid_types}")
        # 不阻止提交，只是警告

    # 检查是否包含任务编号（docs/chore 类型可省略）
    has_task = bool(re.search(r'#\d+-T\d+|第五\S+轮\s*T-?\d+', description))

    if commit_type in ['docs', 'chore', 'ci', 'build']:
        print(f"[hook] ✅ {commit_type} 类型，无需任务编号")
        return True

    if not has_task:
        print(f"[hook] ⚠️ 未检测到任务编号，建议格式: {commit_type}: xxx #54-T1")
        # 不阻止提交，只是警告

    print(f"[hook] ✅ 格式正确: {first_line}")
    return True

def main():
    # 读取 commit message 文件
    commit_msg_file = sys.argv[1]
    with open(commit_msg_file, 'r', encoding='utf-8') as f:
        msg = f.read()

    if not validate_commit_message(msg):
        sys.exit(1)
    else:
        sys.exit(0)

if __name__ == '__main__':
    main()
